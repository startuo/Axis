{
	"name": "mizuki",
	"type": "module",
	"version": "8.3",
	"scripts": {
		"build:cloudflare": "node scripts/build-cloudflare.mjs",
		"dev:cloudflare": "wrangler dev --config wrangler.api.jsonc",
		"deploy:cloudflare": "pnpm build:cloudflare && wrangler deploy --config wrangler.api.jsonc",
		"db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.api.jsonc",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.api.jsonc",
		"test:worker": "node --test workers/test/*.test.mjs",
		"test:frontend": "node --test scripts/frontend-lifecycle.test.mjs",
		"test:frontend:browser": "node scripts/frontend-browser.mjs after",
		"sync:obsidian": "node scripts/sync-obsidian.mjs",
		"build:static": "astro build && pagefind --site dist",
		"sync-content": "node scripts/sync-content.js",
		"init-content": "node scripts/init-content-repo.js",
		"predev": "node scripts/sync-content.js || true",
		"prebuild": "node scripts/sync-content.js || true",
		"dev:web": "astro dev",
		"dev": "astro dev",
		"start": "astro dev",
		"check": "astro check",
		"update-anime": "node scripts/update-anime.mjs",
		"update-bangumi": "node scripts/update-bangumi.mjs",
		"update-bilibili": "node scripts/update-bilibili.mjs",
		"build": "node scripts/update-anime.mjs && astro build && pagefind --site dist && node scripts/compress-fonts.js",
		"submit": "node scripts/indexnow-submit.js",
		"preview": "astro preview",
		"astro": "astro",
		"type-check": "tsc --noEmit && tsc --project tsconfig.assets.json",
		"audit:assets": "node scripts/audit-assets.mjs",
		"test:assets": "node --test scripts/audit-assets.test.mjs",
		"new-post": "node scripts/new-post.js",
		"format": "prettier --write ./src",
		"lint": "eslint ./src --fix",
		"preinstall": "npx only-allow pnpm",
		"compress-fonts": "node scripts/compress-fonts.js",
		"test-font-compression": "node scripts/test-font-compression.js",
		"build:mirror": "node scripts/mirror-build.mjs",
		"migrate:content": "node scripts/migrate-content.mjs",
		"mirror:sync": "node scripts/mirror-sync.mjs"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.6",
		"@astrojs/cloudflare": "^12.6.13",
		"@astrojs/rss": "^4.0.15",
		"@astrojs/sitemap": "^3.7.0",
		"@astrojs/svelte": "7.2.5",
		"@expressive-code/core": "^0.41.7",
		"@expressive-code/plugin-collapsible-sections": "^0.41.7",
		"@expressive-code/plugin-line-numbers": "^0.41.7",
		"@fancyapps/ui": "^6.1.12",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource/roboto": "^5.2.10",
		"@iconify-json/fa7-brands": "^1.2.2",
		"@iconify-json/fa7-regular": "^1.2.3",
		"@iconify-json/fa7-solid": "^1.2.4",
		"@iconify-json/material-symbols": "^1.2.59",
		"@iconify-json/simple-icons": "^1.2.71",
		"@iconify/svelte": "^4.2.0",
		"@swup/astro": "^1.8.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"astro": "5.18.0",
		"astro-expressive-code": "^0.41.7",
		"astro-icon": "^1.1.5",
		"axios": "^1.13.6",
		"crypto-js": "^4.2.0",
		"dayjs": "^1.11.19",
		"hastscript": "^9.0.1",
		"katex": "^0.16.33",
		"markdown-it": "^14.1.1",
		"marked": "^16.4.2",
		"mermaid": "^12.0.0",
		"node-html-parser": "^7.0.2",
		"oddmisc": "^1.1.5",
		"overlayscrollbars": "^2.14.0",
		"pagefind": "^1.4.0",
		"photoswipe": "^5.4.4",
		"qrcode": "^1.5.4",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-components": "^0.3.0",
		"rehype-katex": "^7.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-breaks": "^4.0.0",
		"remark-directive": "^3.0.1",
		"remark-directive-rehype": "^0.4.2",
		"remark-gfm": "^4.0.1",
		"remark-github-admonitions-to-directives": "^1.0.5",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"remark-sectionize": "^2.1.0",
		"sanitize-html": "^2.17.1",
		"satori": "^0.19.2",
		"sharp": "^0.34.5",
		"stylus": "^0.64.0",
		"svelte": "^5.53.6",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"undici": "^7.29.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"yaml": "^2.8.1"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "^1.10.6",
		"@iconify-json/mdi": "^1.2.3",
		"@rollup/plugin-yaml": "^4.1.2",
		"@types/hast": "^3.0.4",
		"@types/markdown-it": "^14.1.2",
		"@types/mdast": "^4.0.4",
		"@types/node": "24.10.1",
		"@types/qrcode": "^1.5.6",
		"@types/sanitize-html": "^2.16.0",
		"fontmin": "^1.1.1",
		"postcss-import": "^16.1.1",
		"postcss-nesting": "^13.0.2",
		"prettier": "^3.8.1",
		"wrangler": "4.132.0"
	},
	"packageManager": "pnpm@10.22.0",
	"pnpm": {
		"overrides": {
			"@emmetio/css-parser": "https://codeload.github.com/ramya-rao-a/css-parser/tar.gz/370c480ac103bd17c7bcfb34bf5d577dc40d3660"
		}
	}
}
