---
import "../styles/fonts.css";
import { siteConfig } from "../config";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
}

const { title = "STAR Admin", description = "STAR Blog 管理控制台", lang } = Astro.props;
const pageTitle = `${title} - ${siteConfig.title}`;
const siteLang = (lang || siteConfig.lang).replace("_", "-");
const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;
---

<!doctype html>
<html lang={siteLang} class="admin-document">
	<head>
		<title>{pageTitle}</title>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{
			favicons.map((favicon) => (
				<link
					rel="icon"
					href={favicon.src}
					sizes={favicon.sizes}
					media={
						favicon.theme &&
						`(prefers-color-scheme: ${favicon.theme})`
					}
				/>
			))
		}
		<script is:inline>
			(() => {
				document.documentElement.classList.add("admin-document", "dark");
				document.documentElement.classList.remove("frontend-document");
				window.__starAdminMode = true;
			})();
		</script>
		<slot name="head" />
	</head>
	<body class="admin-mode">
		<script is:inline>
			(() => {
				const FRONTEND_BODY_CLASSES = [
					"is-home",
					"enable-banner",
					"wallpaper-transparent",
					"no-banner-mode",
					"theme-changing",
				];

				const FRONTEND_DOM_SELECTORS = [
					"#navbar-wrapper",
					"#banner-wrapper",
					"[data-fullscreen-wallpaper]",
					".top-gradient-highlight",
					"#page-height-extend",
					"#heart-container",
					".pio-container",
					"#pio",
					"#pio-container",
					"canvas#live2d",
					"canvas.pio-live2d",
					".aplayer",
					".music-player",
					"[data-music-player]",
					"#back-to-top-btn",
					"#toc-wrapper",
					".sidebar-container",
					".right-sidebar-container",
				];

				const isAdminPath = (pathname) =>
					pathname === "/admin" ||
					pathname.startsWith("/admin/") ||
					pathname === "/user" ||
					pathname.startsWith("/user/");

				const cleanupFrontendArtifacts = () => {
					try {
						window.__wallpaper_cleanup?.();
						window.__starCleanupPio?.();
					} catch (_) {
						// Third-party widgets are best-effort cleanup only.
					}

					document.body.classList.add("admin-mode");
					document.body.classList.remove(...FRONTEND_BODY_CLASSES);
					document.documentElement.classList.add("admin-document", "dark");
					document.documentElement.classList.remove("frontend-document");

					for (const selector of FRONTEND_DOM_SELECTORS) {
						document
							.querySelectorAll(selector)
							.forEach((node) => node.remove());
					}
				};

				const forceFullReloadAcrossAdminBoundary = (event) => {
					if (event.defaultPrevented || event.button !== 0) return;
					if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

					const target = event.target;
					const anchor =
						target instanceof Element ? target.closest("a[href]") : null;
					if (!anchor || (anchor.target && anchor.target !== "_self")) return;

					const nextUrl = new URL(anchor.href, window.location.href);
					if (nextUrl.origin !== window.location.origin) return;

					const currentIsAdmin = isAdminPath(window.location.pathname);
					const nextIsAdmin = isAdminPath(nextUrl.pathname);
					if (currentIsAdmin !== nextIsAdmin) {
						event.preventDefault();
						event.stopImmediatePropagation();
						window.location.assign(nextUrl.href);
					}
				};

				cleanupFrontendArtifacts();
				document.addEventListener("click", forceFullReloadAcrossAdminBoundary, true);
				document.addEventListener("astro:after-swap", cleanupFrontendArtifacts);
				document.addEventListener("swup:page:view", cleanupFrontendArtifacts);
			})();
		</script>
		<div class="admin-layout-root">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	html.admin-document,
	html.admin-document body {
		width: 100%;
		min-height: 100%;
		margin: 0;
		background:
			radial-gradient(circle at 78% 10%, rgba(110, 40, 66, 0.42), transparent 34rem),
			radial-gradient(circle at 16% 92%, rgba(72, 26, 45, 0.36), transparent 28rem),
			#10070c;
		color: rgba(255, 255, 255, 0.92);
	}

	body.admin-mode {
		min-height: 100vh;
		overflow: hidden;
		overscroll-behavior: none;
		font-family:
			"萝莉体 第二版",
			"MiSans",
			"PingFang SC",
			"Microsoft YaHei",
			system-ui,
			sans-serif;
		--primary: #fb78ad;
		--line-divider: rgba(255, 255, 255, 0.12);
		--card-bg: rgba(31, 20, 25, 0.92);
		--card-bg-transparent: rgba(31, 20, 25, 0.78);
		--btn-regular-bg: rgba(255, 255, 255, 0.08);
		--btn-regular-bg-hover: rgba(255, 255, 255, 0.14);
		--btn-regular-bg-active: rgba(251, 120, 173, 0.22);
		--page-bg: #10070c;
	}

	body.admin-mode * {
		box-sizing: border-box;
	}

	.admin-layout-root {
		width: 100%;
		height: 100vh;
		overflow-x: hidden;
		overflow-y: auto;
		isolation: isolate;
		padding: clamp(0.75rem, 2vw, 2rem);
	}

	body.admin-mode #navbar-wrapper,
	body.admin-mode #banner-wrapper,
	body.admin-mode [data-fullscreen-wallpaper],
	body.admin-mode .top-gradient-highlight,
	body.admin-mode .pio-container,
	body.admin-mode #pio,
	body.admin-mode #pio-container,
	body.admin-mode canvas#live2d,
	body.admin-mode .aplayer,
	body.admin-mode .music-player,
	body.admin-mode #back-to-top-btn,
	body.admin-mode #toc-wrapper {
		display: none !important;
	}
</style>
