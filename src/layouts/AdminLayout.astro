---
import { siteConfig } from '../config';
interface Props { title?:string; description?:string; lang?:string }
const {title='Axis 管理台',description='Axis 内容工作空间'}=Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content={description}/><title>{title} · {siteConfig.title}</title></head><body><slot/></body></html>
<style is:global>html,body{margin:0;min-height:100%;width:100%}body{font-family:system-ui,sans-serif}</style>
