{
  "name": "axis",
  "main": "workers/index.mjs",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "axis-db",
    // 部署前替换为 Cloudflare D1 控制台的 Database ID。
    "database_id": "4bea7f5a-4392-4def-bb81-8d2cf36c50e3",
    "migrations_dir": "workers/migrations"
  }],
  "triggers": { "crons": ["0 19 * * *"] }
}
