generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum FeedbackStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  articles         Article[]
  feedbackMessages FeedbackMessage[]

  @@map("users")
}

model Article {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(255)
  content     String        @db.Text
  summary     String        @db.VarChar(500)
  coverImage  String?       @map("cover_image") @db.VarChar(500)
  category    String?       @db.VarChar(100)
  tags        String[]      @default([])
  viewCount   Int           @default(0) @map("view_count")
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)

  authorId String @map("author_id") @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([authorId], map: "idx_articles_author_id")
  @@index([status, createdAt], map: "idx_articles_status_created_at")
  @@index([category], map: "idx_articles_category")
  @@index([publishedAt], map: "idx_articles_published_at")
  @@map("articles")
}

model FeedbackMessage {
  id        String         @id @default(uuid()) @db.Uuid
  text      String         @db.VarChar(50)
  color     String         @default("#fb78ad") @db.VarChar(20)
  status    FeedbackStatus @default(PENDING)
  authorId  String         @map("author_id") @db.Uuid
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt], map: "idx_feedback_messages_status_created_at")
  @@index([authorId, createdAt], map: "idx_feedback_messages_author_created_at")
  @@map("feedback_messages")
}
