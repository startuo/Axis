NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:4321

DATABASE_URL="postgresql://star_blog:star_blog@localhost:5432/star_blog?schema=public"
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Phase 4 default push interval for the admin dashboard gateway.
DASHBOARD_PUSH_INTERVAL_MS=5000
ONLINE_VISITOR_TTL_SECONDS=30

# Phase 3 article view count flush cadence.
ARTICLE_VIEW_FLUSH_INTERVAL_MS=5000

# Local Admin seed account.
ADMIN_EMAIL=admin@stars.blog
ADMIN_USERNAME=star
ADMIN_PASSWORD=replace-with-a-strong-admin-password
